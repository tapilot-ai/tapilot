# Normalize line endings for text files
* text=auto eol=lf

# Explicit text files
*.kt     text eol=lf
*.kts    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
*.gradle text eol=lf
*.xml    text eol=lf
*.properties text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.svg    text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf

# Binary files — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.webm   binary
*.mp4    binary
*.so     binary
*.node   binary
*.apk    binary
*.ttf    binary
*.otf    binary
# Preserve checksum-pinned upstream notice bytes, including original line endings.
third-party/notices/** -text -whitespace
