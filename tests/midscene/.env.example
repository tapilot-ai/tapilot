# Host visual controller. Separate from the ChatGPT account logged into Tapilot.
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=
MIDSCENE_MODEL_PROTOCOL=openai-chat
# Required: choose one device explicitly, even if only one is connected.
TAPILOT_E2E_DEVICE_ID=
TAPILOT_E2E_DISPLAY_ID=0
TAPILOT_E2E_PACKAGE=lifeos.md.tapilot
# Optional OR-combined tag filters. Live cases are excluded by default.
MIDSCENE_INCLUDE_TAGS=
MIDSCENE_EXCLUDE_TAGS=

# Resilience profile only: explicit Wi-Fi IPv4 of the selected test phone.
TAPILOT_E2E_WIFI_ADDRESS=
# Private JSON pairing configuration; never commit or print its contents.
TAPILOT_E2E_PAIRING_FILE=
# Auth failure tests require a separate verification package with rejected dummy credentials.
# Set TAPILOT_E2E_PACKAGE to that package before running test:auth-fixture.
