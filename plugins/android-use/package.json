{
  "name": "tapilot",
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "pair": "node server/pair.mjs",
    "test": "node --test test/*.test.mjs",
    "build:ui": "node ui/build.mjs",
    "check:ui": "node ui/build.mjs --check",
    "check": "npm run check:ui && npm test",
    "cli": "node server/cli.mjs",
    "prepack": "npm run build:ui"
  },
  "dependencies": {
    "@midscene/core": "1.15.2-beta-20261012093542.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "bonjour-service": "1.4.4",
    "jose": "6.1.3",
    "openai": "6.3.0",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "zod": "3.25.76",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "esbuild": "0.25.11"
  },
  "overrides": {
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "uuid": "11.1.1"
  },
  "license": "MIT",
  "bin": {
    "tapilot": "server/cli.mjs",
    "android-use": "server/cli.mjs"
  },
  "description": "Control Android phones over Wi-Fi from Codex, Claude Code, or any agent. No ADB required.",
  "files": [
    "server/",
    "ui/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quanru/tapilot.git",
    "directory": "plugins/android-use"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
