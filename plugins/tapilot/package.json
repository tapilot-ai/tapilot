{
  "name": "tapilot",
  "version": "0.6.15",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "pair": "node server/pair.mjs",
    "test": "node --test test/*.test.mjs",
    "build:ui": "node ui/build.mjs",
    "check:ui": "node ui/build.mjs --check",
    "check": "npm run check:ui && npm test",
    "cli": "node server/cli.mjs",
    "prepack": "node scripts/check-pack-policy.mjs && npm run build:ui && node scripts/patch-midscene-zod.mjs",
    "postinstall": "node scripts/patch-midscene-zod.mjs"
  },
  "dependencies": {
    "@midscene/core": "1.17.4",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "bonjour-service": "1.4.4",
    "jose": "6.1.3",
    "openai": "6.3.0",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "zod": "4.6.7",
    "sharp": "0.35.5",
    "@img/sharp-wasm32": "0.35.5"
  },
  "devDependencies": {
    "esbuild": "0.25.11"
  },
  "overrides": {
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "uuid": "11.1.1",
    "undici@>=6 <7": "6.29.1",
    "undici@>=8 <9": "8.12.3",
    "zod": "4.6.7",
    "body-parser": "2.4.0",
    "ip-address": "10.7.5",
    "qs": "6.17.0",
    "fast-uri": "4.2.3"
  },
  "license": "MIT",
  "bin": {
    "tapilot": "server/cli.mjs",
    "android-use": "server/cli.mjs"
  },
  "description": "Control Android phones over Wi-Fi from Codex, Claude Code, or any agent. No ADB required.",
  "files": [
    "server/",
    "ui/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE",
    "plugin.json",
    "mcp.json",
    ".codex-plugin/",
    ".mcp.json",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapilot-ai/tapilot.git",
    "directory": "plugins/tapilot"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
